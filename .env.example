APP_HOST=127.0.0.1
APP_PORT=8000
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=med-gemma-1.5-4b
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_TIMEOUT_SECONDS=120
LOG_MODEL_REASONING=false
EMBEDDING_MODEL=text-embedding-multilingual-e5-small
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage: 
ANSWER_MAX_TOKENS=800
CLARIFY_MAX_TOKENS=400
CLARIFY_MODE=parallel
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Запасные сноски: если модель не поставила ссылок, сервер сопоставляет
# предложения ответа с фрагментами по близости (порог e5). 0 — выключено.
ATTRIBUTION_MIN_SCORE=0.875
# Проверка ссылок модели: предложение со ссылкой должно быть близко к своему
# фрагменту, иначе ответ не подтверждён (стих со ссылкой на протокол). 0 — выключено.
CITATION_MIN_SUPPORT=0.815

# Вход и уточнения медиков. База пользователей и уточнений — DATA_DIR/review.sqlite3.
DATA_DIR=data
AUTH_REQUIRED=true
ADMIN_LOGIN=admin
# Пароль первого администратора; пусто — случайный, печатается в журнал первого запуска.
ADMIN_PASSWORD=
SESSION_HOURS=12
# Принятый медиками ответ отдаётся на близкий по смыслу вопрос. 0 — только на
# тот же вопрос дословно; порог подбирается замером: tools/verified_threshold.py.
VERIFIED_MIN_SCORE=0

# Поиск: vector — только эмбеддинги; hybrid — эмбеддинги и слова (BM25).
RETRIEVAL_MODE=vector
# Переранжирование кандидатов кросс-энкодером; пусто — выключено.
# Например BAAI/bge-reranker-v2-m3 (точнее) или cross-encoder/mmarco-mMiniLMv2-L12-H384-v1 (быстрее).
RERANKER_MODEL=
RERANK_CANDIDATES=20
