APP_HOST=127.0.0.1
APP_PORT=8000
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=med-gemma-1.5-4b
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_TIMEOUT_SECONDS=120
LOG_MODEL_REASONING=false
EMBEDDING_MODEL=text-embedding-multilingual-e5-small
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage: 
ANSWER_MAX_TOKENS=800
CLARIFY_MAX_TOKENS=400
CLARIFY_MODE=parallel
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Запасные сноски: если модель не поставила ссылок, сервер сопоставляет
# предложения ответа с фрагментами по близости (порог e5). 0 — выключено.
ATTRIBUTION_MIN_SCORE=0.875
